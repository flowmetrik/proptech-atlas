---
import Base from '../../layouts/Base.astro';
import ToolCard from '../../components/ToolCard.astro';
import { tools, bySlug, byId, label, url, initials, related, REPO } from '../../lib/catalog';

export function getStaticPaths() {
  return tools.map((tool) => ({ params: { slug: tool.slug }, props: { tool } }));
}
const { tool } = Astro.props;
const alts = (tool.alternatives ?? []).map((s) => bySlug[s]).filter(Boolean);
const near = [...alts, ...related(tool, 8)];
const verif = tool.verification?.status ?? 'unverified';
const verifText: Record<string, string> = {
  unverified: 'Written from public knowledge of the market, not yet re-checked against the vendor’s own sources.',
  verified: `Re-checked against its sources on ${tool.verification?.checked_on}.`,
  stale: 'Last verified more than twelve months ago — treat details as indicative.',
  disputed: 'Contested by the vendor or a contributor. Arbitration in progress.',
};

const origin = (Astro.site?.href ?? 'https://flowmetrik.github.io/').replace(/\/$/, '');
const abs = (p: string) => `${origin}${url(p)}`;
// Le fil d'Ariane structuré : ce qui fait qu'un moteur affiche la hiérarchie
// sous le titre plutôt qu'une URL nue.
const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Explore', item: abs('explore') },
    { '@type': 'ListItem', position: 2, name: label('category', tool.category), item: abs(`categories/${tool.category}`) },
    { '@type': 'ListItem', position: 3, name: tool.name, item: abs(`tools/${tool.slug}`) },
  ],
};
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: tool.name,
  applicationCategory: label('category', tool.category),
  description: tool.description,
  url: tool.website,
  author: { '@type': 'Organization', name: tool.editor },
  offers: { '@type': 'Offer', category: label('pricing', tool.pricing.model) },
  featureList: tool.features,
  ...(tool.logo ? { image: new URL(url(tool.logo.file), Astro.site ?? 'https://flowmetrik.github.io').href } : {}),
  ...(tool.founded ? { datePublished: String(tool.founded) } : {}),
};
---
<Base title={tool.name} description={tool.positioning} jsonld={[jsonld, crumbs]} ogImage={`og/${tool.slug}.png`}>
  <article class="wrap" style="padding:40px 24px 0">
    <p class="mono muted" style="margin-bottom:18px">
      <a href={url('explore')}>Explore</a> ›
      <a href={url(`categories/${tool.category}`)}>{label('category', tool.category)}</a> ›
      {tool.name}
    </p>

    <header style="display:flex;gap:18px;align-items:flex-start;flex-wrap:wrap">
      {tool.logo
        ? <img class="tool-logo" style="width:56px;height:56px" src={url(tool.logo.file)}
               alt={`${tool.name} logo`} width="56" height="56" decoding="async" />
        : <span class="tool-logo" style="width:56px;height:56px;font-size:1.25rem" aria-hidden="true">{initials(tool.name)}</span>}
      <div style="flex:1;min-width:260px">
        <h1 style="font-size:clamp(1.75rem,4vw,2.5rem);margin-bottom:6px">{tool.name}</h1>
        <p class="muted" style="margin:0">
          by {tool.editor}
          {tool.founded && <> · founded {tool.founded}</>}
          · HQ {tool.hq_country}
        </p>
      </div>
      <div style="display:flex;gap:10px">
        <a class="btn" href={tool.website} rel="noopener nofollow">Visit website</a>
      </div>
    </header>

    <p class="lede" style="margin-top:22px;font-size:1.25rem;color:var(--ink)">{tool.positioning}</p>

    <div style="display:flex;flex-wrap:wrap;gap:7px;margin:18px 0 8px">
      <span class="badge badge-accent">{label('category', tool.category)}</span>
      {(tool.also_in ?? []).map((c) => <span class="badge">{label('category', c)}</span>)}
      {tool.markets.map((m) => <span class="badge">{byId.market[m]?.flag} {label('market', m)}</span>)}
      {tool.ai && <span class="badge badge-outline">AI features</span>}
      {tool.product?.open_source && <span class="badge badge-outline">Open source</span>}
      {tool.product?.api && <span class="badge badge-outline">Public API</span>}
    </div>

    <hr class="rule" style="margin:36px 0" />

    <div style="display:grid;grid-template-columns:minmax(0,1.65fr) minmax(260px,1fr);gap:48px;align-items:start">
      <div class="prose">
        <h2 style="margin-top:0">What it is</h2>
        <p>{tool.description}</p>

        <h2>How it is used in real estate</h2>
        <p>{tool.real_estate_use}</p>

        <h2>Features</h2>
        <ul>{tool.features.map((f) => <li>{f}</li>)}</ul>

        <h2>Use cases</h2>
        <table>
          <thead><tr><th>Who</th><th>Job to be done</th></tr></thead>
          <tbody>
            {tool.use_cases.map((u) => (
              <tr><td style="white-space:nowrap"><strong>{label('persona', u.persona)}</strong></td><td>{u.job}</td></tr>
            ))}
          </tbody>
        </table>

        {tool.ai && (
          <>
            <h2>AI capabilities</h2>
            <ul>{tool.ai.capabilities.map((c) => <li>{c}</li>)}</ul>
          </>
        )}

        <h2>Verified reviews</h2>
        {tool.reviews?.length ? (
          <table>
            <thead><tr><th>Source</th><th>Rating</th><th>Reviews</th><th>Sampled</th></tr></thead>
            <tbody>
              {tool.reviews.map((r) => (
                <tr>
                  <td><a href={r.url} rel="noopener nofollow">{r.source}</a></td>
                  <td>{r.rating} / {r.scale}</td>
                  <td>{r.count}</td>
                  <td class="mono">{r.sampled_on}</td>
                </tr>
              ))}
            </tbody>
          </table>
        ) : (
          <div class="callout">
            <strong>No verified review recorded yet.</strong>
            <p style="margin:6px 0 0">
              This project only publishes dated aggregates sampled from public review platforms,
              with the URL that was read. It never generates a rating, and never averages across
              incompatible sources. <a href={url('contribute')}>Add one from a source you can cite →</a>
            </p>
          </div>
        )}

        <h2>Sources</h2>
        <ul>
          {tool.logo && (
            <li>
              <a href={tool.logo.source_url} rel="noopener nofollow">{tool.logo.source_url}</a>
              <span class="muted"> — logo, relevé le {tool.logo.fetched_on}</span>
            </li>
          )}
          {tool.sources.map((s) => (
            <li><a href={s.url} rel="noopener nofollow">{s.url}</a>{s.note && <span class="muted"> — {s.note}</span>}</li>
          ))}
        </ul>
      </div>

      <aside style="display:grid;gap:20px;position:sticky;top:88px">
        <div class="card" style="padding:20px">
          <h3 style="margin-top:0">Product metadata</h3>
          <dl class="kv" style="grid-template-columns:1fr;gap:2px 0;font-size:0.875rem">
            <dt>Pricing model</dt><dd style="margin-bottom:12px">{label('pricing', tool.pricing.model)}{tool.pricing.public_pricing ? ' · public' : ' · on request'}</dd>
            {tool.pricing.from && (<><dt>From</dt><dd style="margin-bottom:12px">{tool.pricing.from} {tool.pricing.currency} {tool.pricing.unit}</dd></>)}
            <dt>Company sizes</dt><dd style="margin-bottom:12px">{tool.company_sizes.map((s) => label('size', s)).join(', ')}</dd>
            <dt>Asset classes</dt><dd style="margin-bottom:12px">{tool.segments.map((s) => label('segment', s)).join(', ')}</dd>
            <dt>Who it serves</dt><dd style="margin-bottom:12px">{tool.personas.map((p) => label('persona', p)).join(', ')}</dd>
            {tool.product?.languages?.length && (<><dt>Languages</dt><dd style="margin-bottom:12px">{tool.product.languages.join(', ')}</dd></>)}
            {tool.product?.mobile?.length ? (<><dt>Mobile</dt><dd style="margin-bottom:12px">{tool.product.mobile.join(', ')}</dd></>) : null}
            {tool.integrations?.length && (<><dt>Integrations</dt><dd>{tool.integrations.join(', ')}</dd></>)}
          </dl>
        </div>

        {tool.signals && (
          <div class="card" style="padding:20px">
            <h3 style="margin-top:0">Verified signals</h3>
            <p class="muted" style="font-size:0.8125rem;margin:0 0 12px">
              Checked directly on the vendor's site on {tool.signals.checked_on}. Unlike the prose
              above, these are machine-verified. An absent signal means <em>not found on that
              date</em> — not that it does not exist.
            </p>
            <ul style="list-style:none;padding:0;margin:0;display:grid;gap:9px;font-size:0.875rem">
              {[
                ['Public pricing', tool.signals.pricing],
                ['API documentation', tool.signals.api_docs],
                ['Security page', tool.signals.security],
                ['Privacy / GDPR', tool.signals.privacy],
                ['Status page', tool.signals.status],
              ].map(([k, v]) => (
                <li style="display:flex;gap:8px;align-items:baseline">
                  <span aria-hidden="true" style={`color:${v ? 'var(--accent-ink)' : 'var(--muted)'}`}>{v ? '●' : '○'}</span>
                  <span style="flex:1">{k}</span>
                  {v ? <a href={v} rel="noopener nofollow">open</a> : <span class="muted">not found</span>}
                </li>
              ))}
              {tool.signals.site_languages?.length && (
                <li style="display:flex;gap:8px;align-items:baseline;border-top:1px solid var(--border);padding-top:9px;margin-top:2px">
                  <span aria-hidden="true" style="color:var(--accent-ink)">●</span>
                  <span style="flex:1">Site languages</span>
                  <span class="mono">{tool.signals.site_languages.join(' ')}</span>
                </li>
              )}
            </ul>
          </div>
        )}

        <div class="card" style="padding:20px">
          <h3 style="margin-top:0">Data quality</h3>
          <p style="font-size:0.875rem;margin:0 0 10px">
            <span class={`badge ${verif === 'verified' ? 'badge-accent' : 'badge-outline'}`}>{verif}</span>
          </p>
          <p class="muted" style="font-size:0.875rem;margin:0 0 12px">{verifText[verif]}</p>
          <p class="mono muted" style="margin:0">Last updated {tool.updated}</p>
        </div>

        <div class="card" style="padding:20px">
          <h3 style="margin-top:0">Machine readable</h3>
          <ul style="list-style:none;padding:0;margin:0;display:grid;gap:8px;font-size:0.875rem">
            <li><a class="mono" href={url(`api/tools/${tool.slug}.json`)}>api/tools/{tool.slug}.json</a></li>
            <li><a class="mono" href={`${REPO}/blob/main/data/tools/${tool.slug}.yaml`} rel="noopener">data/tools/{tool.slug}.yaml</a></li>
            <li><a href={`${REPO}/edit/main/data/tools/${tool.slug}.yaml`} rel="noopener">Suggest an edit →</a></li>
          </ul>
        </div>
      </aside>
    </div>

    {near.length > 0 && (
      <section style="margin-top:56px">
        <hr class="rule" />
        <h2>{alts.length ? 'Alternatives and close matches' : 'Close matches'}</h2>
        <p class="muted" style="max-width:64ch">
          {alts.length > 0 && <>The first {alts.length} are named in this fiche. </>}
          The rest are products the catalogue finds close on category, trade, asset class and
          market — a computed proximity, not a recommendation.
        </p>
        <div class="grid grid-3" style="margin-top:20px">{near.slice(0, 6).map((t) => <ToolCard tool={t} />)}</div>
        <p style="margin-top:20px">
          <a class="btn btn-ghost btn-sm" href={url(`alternatives/${tool.slug}`)}>
            All alternatives to {tool.name} →
          </a>
        </p>
      </section>
    )}
  </article>
</Base>
